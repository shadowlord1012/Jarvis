<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hud="clr-namespace:UI.Controls.HUD;assembly=UI"
        Title="Jarvis"
        Width="1600"
        Height="900"
        WindowStyle="None"
        Background="Black"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <Grid>

        <!-- Main HUD Background -->
        <Grid x:Name="HudContainer" />

        <!-- UI Layer -->
        <Grid>

            <!-- Top Status Bar -->
            
            <!-- Drag Region -->
            <Border
                Height="60"
                VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="DragRegion_MouseLeftButtonDown"/>

            <Button Content="X"
                Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseButton_Click"/>

           
            <!-- Center HUD -->
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <ContentControl x:Name="CenterPanelHost"/>

            </Grid>

        </Grid>

    </Grid>

</Window>